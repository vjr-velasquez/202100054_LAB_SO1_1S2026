{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object"
    },
    "adapterImage": {
      "type": "string",
      "minLength": 1
    },
    "valkeyAddress": {
      "type": "string",
      "minLength": 1
    },
    "adminSecret": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "dashboardTitle": {
      "type": "string",
      "minLength": 1
    },
    "adapterResources": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
